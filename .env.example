
# Subscription-backed company auth. Production path: point at a keychain
# credential id (the login lives encrypted in its owner's keychain; core
# refreshes it centrally). A ChatGPT login is served through pi's openai-codex provider.
#CODEX_AUTH_CREDENTIAL=
#CLAUDE_AUTH_CREDENTIAL=
HARNESS_SECURITY_POSTURE=auto
HARNESS_SHARING_POSTURE=isolated

#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#OPENROUTER_API_KEY=sk-or-...

ORG_ID=acme
PORT=8080

#ORG_BRAND_SELF_LABEL=straylight
#ORG_BRAND_ORG_NAME=Acme Corp
#ORG_BRAND_ACCENT=#4f46e5
#ORG_BRAND_MARK=S

#SLACK_BOT_TOKEN=xoxb-...
#SLACK_APP_TOKEN=xapp-...
#SLACK_BOT_DISPLAY_NAME=straylight
#SLACK_BOT_ICON_EMOJI=:robot_face:

# Feishu (Lark) events use a long connection; card actions need a public
# /feishu/card callback and either a verification token or an encrypt key.
#FEISHU_APP_ID=cli_...
#FEISHU_APP_SECRET=...
#FEISHU_DOMAIN=feishu
#FEISHU_VERIFICATION_TOKEN=
#FEISHU_ENCRYPT_KEY=
#FEISHU_CARD_CALLBACK_URL=https://your-host/feishu/card
#FEISHU_OAUTH_REDIRECT_URL=https://your-host/v1/connectors/oauth/feishu/callback
#FEISHU_BOT_NAME=straylight

CORE_SIGNING_SECRET=
CAPABILITY_SECRET=
CAPABILITY_TOKEN_COMPRESSION=0
SANDBOX_CAPABILITY_TTL_HOURS=48
PORTAL_IDENTITY_SECRET=
CONNECTOR_SECRET_KEY=
SKILL_SIGNING_SECRET=
INBOX_USERS=

BUDGET_USD_PER_WINDOW=25
ORG_BUDGET_USD_PER_WINDOW=100
BUDGET_WINDOW_MS=86400000

# Extra root CA (PEM content) trusted for the Postgres connection, for providers that pin a private root. Optional; verification stays on. (core)
# DATABASE_CA_CERT=

# Defaults resolved once for each new swarm; initial spawn may override these.
# SWARM_DEFAULTS={"agents":32,"turnMs":600000}
SLACK_HISTORY_LIMIT=
