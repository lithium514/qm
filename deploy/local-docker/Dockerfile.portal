FROM node:24.22.1-alpine3.24@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53

WORKDIR /app

ENV NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
COPY plugins/portal/package.json ./
COPY deploy/local-docker/locks/portal-package-lock.json ./package-lock.json
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev && rm -rf /tmp/node-compile-cache

COPY plugins/portal/src ./src
COPY plugins/auth/src /auth/src
RUN ln -s /app/node_modules /auth/node_modules
COPY plugins/chassis/src /chassis/src
COPY plugins/portal/tsconfig.json ./

ARG GIT_SHA=
ENV GIT_SHA=$GIT_SHA
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080
RUN sed -i 's#dl-cdn.alpinelinux.org#mirrors.aliyun.com#g' /etc/apk/repositories \
  && apk add --no-cache util-linux
USER node
CMD ["node", "src/index.ts"]
